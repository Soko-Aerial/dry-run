{
  "name": "dry-run",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/electron.mjs dev",
    "build": "tsc --noEmit && vite build && node scripts/electron.mjs build",
    "start": "node scripts/electron.mjs start",
    "lint": "eslint",
    "test": "tsx lib/trajectory.test.ts && tsx lib/mission.test.ts && tsx lib/png.test.mts && tsx lib/model-yaw.test.ts && tsx lib/mavlink.test.ts && tsx electron/mavlink.test.ts",
    "dist": "pnpm build && electron-builder --publish never"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "7.1.1",
    "lucide-react": "^1.44.0",
    "mapbox-gl": "^3.30.0",
    "next-themes": "^0.4.6",
    "node-mavlink": "2.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.4",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "three": "^0.186.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.0"
  },
  "packageManager": "pnpm@11.1.2",
  "type": "module",
  "description": "Check a drone route against real terrain before you fly.",
  "author": "Soko Aerial",
  "build": {
    "appId": "com.sokoaerial.dryrun",
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "fileAssociations": [
      {
        "ext": "plan",
        "name": "QGroundControl mission",
        "mimeType": "application/x-qgc-plan"
      },
      {
        "ext": "waypoints",
        "name": "ArduPilot waypoints",
        "mimeType": "application/x-ardupilot-waypoints"
      }
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "syncDesktopName": true
    },
    "win": {
      "target": "nsis"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "nsis": {
      "artifactName": "dry-run-setup-${version}.exe"
    },
    "appImage": {
      "artifactName": "dry-run-${version}.AppImage"
    }
  },
  "desktopName": "dry-run.desktop"
}
